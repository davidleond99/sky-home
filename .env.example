# Neon (rama develop en local / Preview, production en Production)
# Conexión pooled para la app (host con -pooler)
DATABASE_URL=
# Conexión directa para drizzle-kit (migraciones)
DATABASE_URL_UNPOOLED=

# Better Auth — genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Solo local: contraseña inicial de los usuarios sembrados por `pnpm db:seed`
SEED_PASSWORD=

# Solo E2E: credenciales de los usuarios de prueba (por defecto = SEED_PASSWORD)
E2E_PASSWORD=
